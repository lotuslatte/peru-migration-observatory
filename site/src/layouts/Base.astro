---
import '../styles/global.css';
import Head from '../kit/ui/Head.astro';
import Nav from '../kit/ui/Nav.astro';
import Footer from '../kit/ui/Footer.astro';
import CommandPalette from '../kit/ui/CommandPalette';
import { SITE_NAME, NAV, FOOTER, SOURCE_SPAN } from '../data/site';
interface Props { title: string; description?: string; wide?: boolean; image?: string; jsonLd?: object }
const { title, description = `Observatorio abierto de la migración interna e internacional en el Perú a partir de microdatos del INEI (ENAHO ${SOURCE_SPAN}, ENPOVE 2018 y 2022, ENAHO-PV 2024).`, wide = false, image, jsonLd } = Astro.props;
---
<html lang="es">
  <head>
    <Head title={title === 'Inicio' ? SITE_NAME : title} siteName={SITE_NAME} description={description} image={image} author="Favio Samillan Flores" authorUrl="https://lotuslatte.github.io/" jsonLd={jsonLd} />
  </head>
  <body>
    <a class="sr-only skip" href="#main">Saltar al contenido</a>
    <Nav name={SITE_NAME} items={NAV} />
    <main id="main" class={wide ? 'wrap wrap-wide' : 'wrap'}>
      <slot />
    </main>
    <Footer name={SITE_NAME} columns={FOOTER}>
      <Fragment slot="source">
        Fuente: INEI, Encuesta Nacional de Hogares (ENAHO) {SOURCE_SPAN}, módulos 200, 300, 400, 500 y sumaria; ENPOVE 2018 y 2022; ENAHO-PV 2024. Estimaciones con factores oficiales y errores estándar de diseño. Licencia <a href="https://creativecommons.org/licenses/by/4.0/deed.es">CC BY 4.0</a>.
      </Fragment>
      <Fragment slot="credit">
        Creado por <a href="https://lotuslatte.github.io/" rel="author">Favio Samillan Flores</a>, economista (PUCP). <a href="https://www.linkedin.com/in/favio-samillan-flores-367054295/" rel="me">LinkedIn</a> · <a href="https://github.com/lotuslatte/peru-migration-observatory">Código en GitHub</a>
      </Fragment>
    </Footer>
    <CommandPalette client:idle src="/data/search.json" />
  </body>
</html>
