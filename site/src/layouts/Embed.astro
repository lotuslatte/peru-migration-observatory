---
import '../styles/global.css';
import Head from '../kit/ui/Head.astro';
import { SITE_NAME } from '../data/site';
interface Props { title: string }
const { title } = Astro.props;
---
<html lang="es">
  <head><Head title={title} siteName={SITE_NAME} description={title} noindex /></head>
  <body class="embed">
    <p class="eyebrow">{title}</p>
    <slot />
    <p class="small muted src">Fuente: INEI. <a href="/" target="_blank" rel="noopener">{SITE_NAME}</a>, CC BY 4.0.</p>
    <style>
      .embed { padding: 12px; } .src { margin-top: 8px; }
    </style>
  </body>
</html>
