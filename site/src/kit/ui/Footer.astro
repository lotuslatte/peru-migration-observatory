---
// Site footer: every section of the site in columns, then source and credit.
interface Props { name: string; columns: { title: string; links: [string, string][] }[] }
const { name, columns } = Astro.props;
---
<footer class="site-footer">
  <div class="wrap">
    <nav class="cols" aria-label="Secciones del sitio">
      {columns.map(c => <div><p class="t">{c.title}</p><ul>{c.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul></div>)}
    </nav>
    <div class="base">
      <p class="name">{name}</p>
      <div class="src"><slot name="source" /></div>
      <div class="credit"><slot name="credit" /></div>
    </div>
  </div>
</footer>
<style>
  .site-footer { margin-top: var(--s-9); border-top: 1px solid var(--ink); padding: var(--s-6) 0 var(--s-7); font-size: var(--text-sm); color: var(--ink-2); }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--s-5) var(--s-6); }
  .t { font-weight: 600; color: var(--ink); margin: 0 0 var(--s-2); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .cols a { text-decoration: none; color: var(--ink-2); } .cols a:hover { color: var(--ink); text-decoration: underline; }
  .base { margin-top: var(--s-6); padding-top: var(--s-4); border-top: 1px solid var(--line); display: grid; gap: var(--s-2); max-width: 80ch; }
  .name { font-weight: 600; color: var(--ink); margin: 0; }
  .src, .credit { color: var(--muted); }
</style>
