---
import Base from '../layouts/Base.astro';
import MapPicker from '../kit/charts/MapPicker';
import LineChart from '../kit/charts/LineChart';
import { peruMap } from '../kit/data/peruMap';
import { fmtUnit, fmtInt } from '../kit/charts/lib/format';
import { loadHeadline, loadAtlas, loadFlows, loadVenezuela, loadTrends } from '../data/loaders';
import { INDICATORS, YEAR, YEARS, slim } from '../data/indicators';
import { SITE_NAME, SOURCE_SPAN } from '../data/site';

const h = loadHeadline(); const a = loadAtlas(); const fl = loadFlows(); const vz = loadVenezuela(); const tr = loadTrends();
const PREV = YEAR - 1;
const lead = h.kpis.life_cross;
const depts = a.regions.filter(r => !r.parent && r.id.length === 2);

// Map layers: net migration first (signed, two hues), then the main rates.
const layerIds = ['net_rate', 'mig5_cross', 'out_rate', 'life_cross'];
const layerNames: Record<string, string> = { net_rate: 'Saldo migratorio (por mil, 2020–2024)', mig5_cross: 'Llegaron de otro departamento', out_rate: 'Se fueron a otro departamento', life_cross: 'Nacidos en otro departamento' };
const layers = layerIds.map(id => { const d = a.dims.find(x => x.id === id)!; return { id, name: layerNames[id], unit: d.unit, scale: id === 'net_rate' ? 'div' as const : 'seq' as const, rows: depts.map(r => ({ id: r.id, name: r.name, c: slim(r.values[id]) })) }; });

const byNet = [...depts].filter(r => r.values.net_rate.v != null).sort((x, y) => y.values.net_rate.v! - x.values.net_rate.v!);
const signals = ['mig5_cross', 'mig5_intl', 'gap_inf_mig', 'gap_inc_mig', 'mig5_any'].map(id => INDICATORS.find(i => i.id === id)!).filter(Boolean);
const what: Record<string, string> = { mig5_cross: 'vivía en otro departamento hace cinco años', mig5_intl: 'vivía en otro país hace cinco años', gap_inf_mig: 'más informalidad entre migrantes recientes', gap_inc_mig: 'gana el migrante por cada sol del no migrante', mig5_any: 'vivía en otro distrito hace cinco años' };
function spark(id: string) {
  const cells = tr.series.national[id]; const vs = cells.filter((c: any) => c.v != null).map((c: any) => c.v), lo = Math.min(...vs), hi = Math.max(...vs);
  const X = (i: number) => 2 + i / (YEARS.length - 1) * 196, Y = (v: number) => 32 - (v - lo) / ((hi - lo) || 1) * 28;
  const pts = cells.map((c: any, i: number) => c.v == null ? null : `${X(i)},${Y(c.v)}`).filter(Boolean);
  return { points: pts.join(' '), end: [X(YEARS.length - 1), Y(cells.at(-1).v)] };
}
function change(id: string, unit: string) {
  const d = h.deltas[id]?.d1;
  return d?.sig ? `${d.d > 0 ? 'Sube' : 'Baja'} ${fmtUnit(Math.abs(d.d), unit === '%' ? 'pp' : unit)} frente a ${PREV}` : `Sin cambio significativo frente a ${PREV}`;
}
const top = fl.top_flows.slice(0, 6);
const vz24 = vz.waves['2024'];
const jsonLd = { '@context': 'https://schema.org', '@type': 'Dataset', name: `${SITE_NAME}, ${SOURCE_SPAN}`, description: 'Indicadores de migración interna e internacional en el Perú estimados con microdatos del INEI, con error estándar, intervalo de confianza y sello de calidad.', license: 'https://creativecommons.org/licenses/by/4.0/', creator: { '@type': 'Person', name: 'Favio Samillan Flores' }, temporalCoverage: `2014/${YEAR}`, spatialCoverage: 'Perú', isAccessibleForFree: true };
---
<Base title="Inicio" jsonLd={jsonLd}>
  <section class="home-hero">
    <div>
      <p class="eyebrow">Migración en el Perú, {YEAR}</p>
      <div class="big">{fmtUnit(lead.v, '%')}</div>
      <h1>de las personas viven en un departamento distinto de aquel donde nacieron.</h1>
      <p class="r-src">ENAHO {YEAR} del INEI, {fmtInt(h.n_persons)} personas de 5 años a más. IC 95%: {fmtUnit(lead.lo, '%')} a {fmtUnit(lead.hi, '%')}. <a href="/indicadores/life_cross/">Ver el indicador</a>.</p>
      <button class="find" type="button" data-open-palette>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        <span>Buscar un indicador o un lugar</span><kbd>Ctrl K</kbd>
      </button>
      <p class="r-say">{byNet[0].name} y {byNet[1].name} ganan población ({fmtUnit(byNet[0].values.net_rate.v, '‰')} y {fmtUnit(byNet[1].values.net_rate.v, '‰')} en cinco años). {byNet.at(-1)!.name} y {byNet.at(-2)!.name} la pierden ({fmtUnit(byNet.at(-1)!.values.net_rate.v, '‰')} y {fmtUnit(byNet.at(-2)!.values.net_rate.v, '‰')}).</p>
    </div>
    <MapPicker client:load map={peruMap()} layers={layers} year={YEAR} />
  </section>

  <section class="home-sec">
    <h2>Cinco señales más</h2>
    <div class="r-signals">
      {signals.map(i => { const s = spark(i.id); return (
        <a class="r-signal" href={`/indicadores/${i.id}/`}>
          <span class="num">{fmtUnit(tr.series.national[i.id].at(-1).v, i.unit)}</span>
          <span class="name">{i.name}</span><span class="what">{what[i.id]}</span>
          <svg viewBox="0 0 200 36" aria-hidden="true"><polyline fill="none" stroke="var(--ink)" stroke-width="1.5" points={s.points} /><circle cx={s.end[0]} cy={s.end[1]} r="3.2" fill="var(--accent)" /></svg>
          <span class="chg">{change(i.id, i.unit)}</span>
        </a>); })}
      <a class="r-signal all" href="/indicadores/"><span class="num">{INDICATORS.length}</span><span class="name">Todos los indicadores</span><span class="what">cada uno con tendencia, mapa, grupos, método y descarga</span></a>
    </div>
  </section>

  <section class="home-sec">
    <h2>Por dónde se mueve la gente</h2>
    <div class="home-cols">
      <div>
        <h3>Los seis corredores más grandes</h3>
        <table class="data"><thead><tr><th scope="col">De</th><th scope="col" style="text-align:left">A</th><th scope="col">Personas al año</th></tr></thead>
          <tbody>{top.map((t: any) => <tr><td>{fl.dept_names[t.o]}</td><td style="text-align:left">{fl.dept_names[t.d]}</td><td>{fmtInt(t.flow)}{t.g === 'B' && <span class="r-grade"> B</span>}</td></tr>)}</tbody></table>
        <p class="r-src">Promedio anual 2020–2024. B: estimación menos precisa. <a href="/flujos/">Ver todos los flujos</a>.</p>
      </div>
      <div>
        <h3>Población venezolana, 2024</h3>
        <p>Unos {(vz24.pop / 1e6).toFixed(2)} millones de personas según la ENAHO-PV: {fmtUnit(vz24.all.employed.v, '%')} ocupadas, {fmtUnit(vz24.all.informal.v, '%')} en la informalidad y {fmtUnit(vz24.all.regular.v, '%')} con permiso migratorio.</p>
        <LineChart client:visible years={YEARS} unit="%" title="Llegadas del extranjero y desde Venezuela en los últimos cinco años" name="omp_llegadas_extranjero" yTitle="Porcentaje de la población de 5 años a más"
          series={[{ label: 'Del extranjero', cells: tr.series.national.mig5_intl.map(slim), color: 'var(--ink)' }, { label: 'De Venezuela', cells: tr.series.national.mig5_ven.map(slim), color: 'var(--accent)' }]} yZero exportBar={false} />
        <p class="r-src">La ENAHO subestima a la población extranjera; las encuestas especializadas la miden mejor. <a href="/venezuela/">Tres encuestas, 2018–2024</a>.</p>
      </div>
    </div>
  </section>

  <section class="home-sec">
    <h2>Cómo usar el observatorio</h2>
    <div class="home-cols">
      <div>
        <h3>Cada cifra trae su precisión</h3>
        <p>Toda estimación se publica con su intervalo de confianza de 95% y un sello.</p>
        <dl class="seals">
          <div><dt><span class="badge A"></span></dt><dd>Error relativo menor que 15%.</dd></div>
          <div><dt><span class="badge B"></span></dt><dd>Entre 15% y 30%: leer con cautela.</dd></div>
          <div><dt><span class="badge S"></span></dt><dd>30% o más, o menos de 30 casos: no se publica.</dd></div>
        </dl>
        <p style="margin-top:12px"><a href="/acerca/metodologia/">Metodología</a> · <a href="/acerca/validacion/">Validación</a></p>
      </div>
      <div>
        <h3>Por territorio</h3>
        <p>Perfiles de los 25 departamentos, Lima Metropolitana y Lima Región, y un atlas de 196 provincias.</p>
        <p><a href="/atlas/">Departamentos</a> · <a href="/atlas/provincias/">Provincias</a></p>
        <h3 style="margin-top:24px">Para leer</h3>
        <p><a href="/historias/peru-en-movimiento/">Perú en movimiento</a> · <a href="/clima/">Clima y movilidad</a> · <a href="/analisis/">Análisis con controles</a></p>
      </div>
      <div>
        <h3>Datos abiertos</h3>
        <p>Todas las estimaciones y las tablas del compendio, con diccionario. Licencia CC BY 4.0.</p>
        <p><a href="/datos/">Descargar y citar</a> · <a href="/compendio/">Compendio de tablas</a> · <a href="/novedades/">Qué cambió</a></p>
      </div>
    </div>
  </section>
</Base>
