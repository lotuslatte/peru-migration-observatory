---
import Base from '../../../layouts/Base.astro';
import HowToRead from '../../../components/ui/HowToRead.astro';
import ScrollyScene from '../../../components/charts/ScrollyScene';
import AtlasMap from '../../../components/charts/AtlasMap';
import { loadHeadline, loadAtlas, loadFlows, loadVenezuela, loadClimate } from '../../../data/loaders';
const h = loadHeadline(); const a = loadAtlas(); const fl = loadFlows(); const vz = loadVenezuela(); const cl = loadClimate();
const k = h.kpis; const f = (c: any, n = 1) => c?.v == null ? '—' : c.v.toLocaleString('es-PE', { minimumFractionDigits: n, maximumFractionDigits: n });
const by = (dom: string, ind: string, key: string) => h.by[dom][ind][key];
const lab = (ind: string, key: string) => h.labour[ind][key];
const depts = a.regions.filter(r => !r.parent);
const net = [...depts].filter(r => r.values.net_rate.v != null).sort((x, y) => (y.values.net_rate.v ?? 0) - (x.values.net_rate.v ?? 0));
const top = fl.top_flows.slice(0, 6);
const w24 = vz.waves['2024'], w18 = vz.waves['2018'];
const lima = fl.by_dept['15'];
const nat = (ind: string) => h.trend[ind].map((c: any) => c.v);
const dry = cl.terciles.dry_years; const cl_adj = (await import('../../../data/loaders')).loadDrought().specs.dry.adj.v;
const steps = [
  { id: 'escala', title: 'La escala del movimiento', html: `<p>En 2024, <strong>${f(k.life_cross)} %</strong> de los peruanos vive en un departamento distinto al de su nacimiento: uno de cada cinco. En sólo cinco años, <strong>${f(k.mig5_cross, 2)} %</strong> cruzó una frontera departamental, ${f(k.mig5_intra, 2)} % se mudó dentro de su departamento y ${f(k.mig5_intl, 2)} % llegó del extranjero. Sumados, unos ${((h.totals.n_mig5_cross.v ?? 0) / 1000).toFixed(0)} mil peruanos cambiaron de departamento en el último lustro.</p><p>La migración interna no es un fenómeno del pasado: la tasa de inmigración reciente se mueve entre ${f({ v: Math.min(...nat('mig5_cross').filter(Boolean)) }, 1)} % y ${f({ v: Math.max(...nat('mig5_cross').filter(Boolean)) }, 1)} % desde 2014, con una caída en 2020 y una recuperación inmediata.</p><p class="small muted">Compendio: T01, T17.</p>`,
    chart: { type: 'lines', title: 'Movilidad reciente, 2014–2024 (% de la población de 5+)', years: h.years, series: [{ key: 'cross', label: 'Llegó de otro dpto.', values: nat('mig5_cross') }, { key: 'intra', label: 'Se mudó dentro del dpto.', values: nat('mig5_intra') }, { key: 'intl', label: 'Del extranjero', values: nat('mig5_intl') }], note: 'ENAHO, residencia hace 5 años.', annotations: [{ key: 'intl', text: 'El salto venezolano, 2018–2019', dx: -160, dy: -40 }] } },
  { id: 'lima', title: 'Lima: imán y expulsor', html: `<p>Lima recibe cada año unas ${(lima.inm.at(-1) / 5 / 1000).toFixed(0)} mil personas de otros departamentos —desde ${lima.top_origins.slice(0, 3).map((x: any) => x.name).join(', ')}— pero envía otras ${(lima.emi.at(-1) / 5 / 1000).toFixed(0)} mil hacia ${lima.top_destinations.slice(0, 3).map((x: any) => x.name).join(', ')}. Su saldo en cinco años es de <strong>${f(a.regions.find(r => r.id === '15')?.values.net_rate)} por mil</strong>: la capital ya no crece por migración.</p><p>Los corredores mayores del país tienen a Lima en un extremo: ${top.slice(0, 3).map((t: any) => `${fl.dept_names[t.o]} → ${fl.dept_names[t.d]} (~${t.flow.toLocaleString('es-PE')}/año)`).join('; ')}.</p><p class="small muted">Compendio: T03, T04.</p>`,
    chart: { type: 'bars', title: 'Los seis corredores mayores (personas / año, 2020–2024)', unit: '', items: top.map((t: any) => ({ key: `${t.o}-${t.d}`, label: `${fl.dept_names[t.o]} → ${fl.dept_names[t.d]}`, v: t.flow, color: t.o === '15' ? 1 : 0 })), note: 'Carmín: llegan a Lima u otros. Jade: salen de Lima.' } },
  { id: 'jovenes', title: 'Migra quien tiene entre 15 y 44 años', html: `<p>La tasa de inmigración reciente es de <strong>${f(by('age5', 'mig5_cross', '1'), 2)} %</strong> entre los 15 y 29 años y ${f(by('age5', 'mig5_cross', '2'), 2)} % entre los 30 y 44, contra ${f(by('age5', 'mig5_cross', '3'), 2)} % entre 45 y 64. Los niños migran con sus padres (${f(by('age5', 'mig5_cross', '0'), 2)} %). Por educación, se mueven más quienes tienen secundaria o superior no universitaria (${f(by('educ4', 'mig5_cross', '2'), 2)} %, ${f(by('educ4', 'mig5_cross', '3'), 2)} %) que quienes tienen sólo primaria (${f(by('educ4', 'mig5_cross', '1'), 2)} %).</p><p class="small muted">Compendio: T02, T07.</p>`,
    chart: { type: 'bars', title: 'Inmigración reciente por edad y educación, 2024 (%)', items: [{ label: '5–14', v: by('age5', 'mig5_cross', '0').v }, { label: '15–29', v: by('age5', 'mig5_cross', '1').v }, { label: '30–44', v: by('age5', 'mig5_cross', '2').v }, { label: '45–64', v: by('age5', 'mig5_cross', '3').v }, { label: '65+', v: by('age5', 'mig5_cross', '4').v }, { label: 'Hasta primaria', v: by('educ4', 'mig5_cross', '1').v, color: 1 }, { label: 'Secundaria', v: by('educ4', 'mig5_cross', '2').v, color: 1 }, { label: 'Sup. no universitaria', v: by('educ4', 'mig5_cross', '3').v, color: 1 }, { label: 'Universitaria', v: by('educ4', 'mig5_cross', '4').v, color: 1 }] } },
  { id: 'selva', title: 'La selva es la nueva frontera', html: `<p>La región con más inmigrantes recientes no es Lima sino la selva: <strong>${f(by('region_nat', 'mig5_cross', '3'), 2)} %</strong> de su población llegó de otro departamento en cinco años, contra ${f(by('region_nat', 'mig5_cross', '4'), 2)} % en Lima Metropolitana, ${f(by('region_nat', 'mig5_cross', '1'), 2)} % en la costa y ${f(by('region_nat', 'mig5_cross', '2'), 2)} % en la sierra. ${net[0]?.name} (+${f(net[0]?.values.net_rate)} por mil) y ${net[1]?.name} (+${f(net[1]?.values.net_rate)}) encabezan el saldo; ${net.at(-1)?.name} (${f(net.at(-1)?.values.net_rate)}) y ${net.at(-2)?.name} (${f(net.at(-2)?.values.net_rate)}) lo cierran.</p><p class="small muted">Compendio: T02, T11.</p>`,
    chart: { type: 'map', title: 'Saldo migratorio neto por mil habitantes, 2020–2024', unit: '‰', higherBetter: true, items: depts.map(r => ({ key: r.id, label: r.name, v: r.values.net_rate.v, highlight: [net[0]?.id, net[1]?.id, net.at(-1)?.id, net.at(-2)?.id].includes(r.id), color: (r.values.net_rate.v ?? 0) > 0 ? 1 : 0 })), note: 'Más oscuro = mayor saldo positivo. Puntos: los dos que más ganan y los dos que más pierden.' } },
  { id: 'venezuela', title: 'La llegada venezolana', html: `<p>Entre 2017 y 2019 la ENAHO registra el salto de las llegadas del extranjero: de ${f(h.trend.mig5_intl[3], 2)} % a <strong>${f(h.trend.mig5_intl[5], 2)} %</strong> de la población en cinco años, casi toda desde Venezuela. Pero la encuesta general subestima el fenómeno: ENAHO-PV 2024 estima <strong>${(w24.pop / 1e6).toFixed(2)} millones</strong> de personas venezolanas, con ${f(w24.all.employed)} % ocupadas y <strong>${f(w24.all.informal)} %</strong> en la informalidad, ${f(w24.all.regular)} % con permiso migratorio y ${f(w24.all.discrim)} % que reporta discriminación (${f(w18.all.discrim)} % en 2018).</p><p class="small muted">Compendio: T14, T15.</p>`,
    chart: { type: 'bars', title: 'Población venezolana 2024 (%)', items: [{ label: 'Ocupados', v: w24.all.employed.v, color: 1 }, { label: 'Empleo informal', v: w24.all.informal.v }, { label: 'Con permiso migratorio', v: w24.all.regular.v, color: 1 }, { label: 'Educación superior', v: w24.all.superior.v, color: 1 }, { label: 'Sufrió discriminación', v: w24.all.discrim.v }, { label: 'Piensa quedarse', v: w24.all.stay.v, color: 1 }] } },
  { id: 'clima', title: 'El clima: menos de lo que se cree', html: `<p>La intuición dice que las sequías empujan a la gente fuera. Los datos departamentales dicen otra cosa: en los departamentos-año del tercil con <em>más</em> años secos la tasa de emigración es de <strong>${f({ v: dry[2].out_rate })} %</strong>, frente a ${f({ v: dry[0].out_rate })} % en el tercil de menor exposición (correlación ${cl.corr_out_rate.dry_years}). La anomalía térmica muestra el mismo signo débil (${cl.corr_out_rate.temp_anom}).</p><p>Pero al comparar personas con la misma edad, educación, área y región, la diferencia desaparece: el efecto de un año seco adicional es de ${cl_adj} pp con un intervalo que incluye el cero. Los departamentos secos son también más rurales y andinos, y allí se migra menos por razones que no son el clima. Con datos de encuesta a nivel departamental, el clima no aparece como motor de la migración interna reciente.</p><p class="small muted">Compendio: T16. Ver <a href="/clima/">Clima</a>.</p>`,
    chart: { type: 'bars', title: 'Tasa de emigración por tercil de años secos, 2014–2023 (%)', items: dry.map((t: any) => ({ label: ['Menor exposición', 'Media', 'Mayor exposición'][t.tercile - 1], v: t.out_rate, color: t.tercile === 3 ? 1 : 0 })), note: 'Promedios ponderados por población de departamento-año.' } },
  { id: 'resultado', title: '¿A quién le va mejor?', html: `<p>Los migrantes recientes participan más en el mercado laboral (${f(lab('lfpr', '2'))} % vs ${f(lab('lfpr', '0'))} %) y tienen menos desempleo (${f(lab('ur', '2'))} % vs ${f(lab('ur', '0'))} %), pero trabajan con <strong>${f(lab('informality', '2'))} % de informalidad</strong> frente a ${f(lab('informality', '0'))} % de quienes no se movieron —una brecha de ${f(k.gap_inf_mig)} puntos— y menos contrato (${f(lab('contract_any', '2'))} % vs ${f(lab('contract_any', '0'))} %). Su ingreso mediano es, sin embargo, mayor: S/ ${f(lab('median_inc_real', '2'), 0)} contra S/ ${f(lab('median_inc_real', '0'), 0)}. Migrar paga en ingreso; se cobra en protección.</p><p class="small muted">Compendio: T09, T10.</p>`,
    chart: { type: 'bars', title: 'Migrantes recientes vs no migrantes, 2024 (%)', items: [{ label: 'Actividad · migrantes', v: lab('lfpr', '2').v }, { label: 'Actividad · no migrantes', v: lab('lfpr', '0').v, color: 1 }, { label: 'Informalidad · migrantes', v: lab('informality', '2').v }, { label: 'Informalidad · no migrantes', v: lab('informality', '0').v, color: 1 }, { label: 'Con contrato · migrantes', v: lab('contract_any', '2').v }, { label: 'Con contrato · no migrantes', v: lab('contract_any', '0').v, color: 1 }, { label: 'Pobreza · migrantes', v: lab('pobre', '2').v }, { label: 'Pobreza · no migrantes', v: lab('pobre', '0').v, color: 1 }] } },
];
---
<Base title="El Perú se mueve hacia la costa" wide>
  <div class="eyebrow" style="margin-top:28px">Historia · ENAHO 2014–2024 · ENPOVE · clima</div>
  <h1>El Perú se mueve <em>hacia la costa</em> (y hacia la selva)</h1>
  <p class="lede">Siete capítulos sobre quién se mueve, hacia dónde y con qué resultado. Cada cifra lleva su tabla del compendio.</p>
  <HowToRead />
  <ScrollyScene client:load steps={steps} mapNames={fl.dept_names} />
  <section class="card" style="margin-top:32px"><div class="eyebrow">Epílogo</div><h2>El mapa del saldo</h2><AtlasMap client:visible regions={a.regions} dims={a.dims} year={a.year} initial="net_rate" /></section>
</Base>
