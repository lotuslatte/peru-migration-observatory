---
import Base from '../../layouts/Base.astro';
import GradeLegend from '../../components/ui/GradeLegend.astro';
import AtlasMap from '../../components/charts/AtlasMap';
import fs from 'node:fs'; import path from 'node:path';
const p = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), 'public/data/atlas_provincias.json'), 'utf8'));
const f = (c: any, n = 1) => c?.v == null ? '—' : c.v.toLocaleString('es-PE', { minimumFractionDigits: n, maximumFractionDigits: n });
const counts = Object.fromEntries(p.dims.map((d: any) => [d.id, p.regions.filter((r: any) => r.values[d.id]?.g !== 'S').length]));
---
<Base title="Atlas provincial" wide>
  <div class="eyebrow" style="margin-top:28px">Atlas provincial · {p.years[0]}–{p.years.at(-1)} agrupados · {p.n_regions} provincias</div>
  <h1>Ciento noventa y seis provincias, <em>no veinticinco departamentos.</em></h1>
  <p class="lede">Agrupando tres años de ENAHO cada provincia tiene muestra suficiente para la mayoría de indicadores. Los contornos gruesos son departamentos; las celdas sin sello se muestran en gris. El desempleo no se publica a este nivel: la proporción es demasiado pequeña para medirla con precisión provincial.</p>
  <div class="grid grid-4" style="margin-bottom:14px">{p.dims.map((d: any) => <div class="card" style="padding:10px 12px"><div class="eyebrow">{d.label_es}</div><div class="small">{counts[d.id]} de {p.n_regions} provincias publicables</div></div>)}</div>
  <section class="card"><GradeLegend compact /><AtlasMap client:load regions={p.regions} dims={p.dims} year={`${p.years[0]}–${p.years.at(-1)}`} level="prov" initial={p.dims[0].id} /></section>
  <p class="small muted" style="margin-top:14px">{p.note} Descarga: <a href="/data/atlas_provincias.json">atlas_provincias.json</a>.</p>
</Base>
