na"},{"label":"Datos","href":"/datos/","group":"Página"},{"label":"Método","href":"/acerca/metodologia/","group":"Página"},{"label":"Qué cambió","href":"/novedades/","group":"Página"},{"label":"Compendio de tablas","href":"/compendio/","group":"Página"},{"label":"Provincias","href":"/atlas/provincias/","group":"Página"},{"label":"Perú en movimiento","href":"/historias/peru-en-movimiento/","group":"Página"},{"label":"Clima y movilidad","href":"/clima/","group":"Página"},{"label":"Análisis con controles","href":"/analisis/","group":"Página"},{"label":"Glosario","href":"/glosario/","group":"Página"},{"label":"Preguntas frecuentes","href":"/preguntas/","group":"Página"},{"label":"Validación","href":"/acerca/validacion/","group":"Página"},{"label":"Acerca de","href":"/acerca/","group":"Página"},{"label":"PET","href":"/glosario/#pet","group":"Glosario","hint":"Población en edad de trabajar: personas de 14 años o más (convención INEI)."},{"label":"PEA","href":"/glosario/#pea","group":"Glosario","hint":"Población económicamente activa: ocupados más desocupados abiertos (buscaron trabajo la semana de referencia)."},{"label":"Tasa de actividad","href":"/glosario/#tasa-de-actividad","group":"Glosario","hint":"PEA dividida entre la PET. Mide cuántos participan, no cuántos tienen buen empleo."},{"label":"Tasa de desempleo","href":"/glosario/#tasa-de-desempleo","group":"Glosario","hint":"Desocupados abiertos entre la PEA. En el Perú es baja porque sin seguro de desempleo la gente se autoemplea."},{"label":"Empleo informal","href":"/glosario/#empleo-informal","group":"Glosario","hint":"Definición INEI/OIT: trabajar en una unidad no registrada en SUNAT, o como asalariado sin seguro de salud ni pensión ligados al empleo, o como familiar no remunerado."},{"label":"Empleo adecuado","href":"/glosario/#empleo-adecuado","group":"Glosario","hint":"Ocupado sin subempleo por horas (quiere y puede trabajar más) ni por ingresos (gana menos que la remuneración mínima)."},{"label":"Sello de confiabilidad","href":"/glosario/#sello-de-confiabilidad","group":"Glosario","hint":"Resumen de la precisión: Sólido (error relativo < 15 %), Cautela (15–30 %), Suprimido (≥ 30 % o menos de 30 casos)."},{"label":"Error estándar de diseño","href":"/glosario/#error-est-ndar-de-dise-o","group":"Glosario","hint":"Incertidumbre que reconoce que la ENAHO muestrea conglomerados y estratos, no personas al azar; se calcula por linealización de Taylor."},{"label":"IC 95 %","href":"/glosario/#ic-95-","group":"Glosario","hint":"Intervalo de confianza: rango que contendría el valor verdadero en 95 de cada 100 muestras."},{"label":"Brecha ajustada","href":"/glosario/#brecha-ajustada","group":"Glosario","hint":"Diferencia entre grupos después de comparar personas con la misma edad, educación, región, etc. (modelo con controles)."},{"label":"Oaxaca–Blinder","href":"/glosario/#oaxaca-blinder","group":"Glosario","hint":"Descomposición de una brecha en la parte explicada por características distintas y la parte no explicada (retornos distintos a las mismas características)."},{"label":"Shift-share","href":"/glosario/#shift-share","group":"Glosario","hint":"Descomposición de un cambio en el tiempo entre cambio de composición (quién trabaja dónde) y cambio de tasas dentro de cada grupo."},{"label":"Migrante reciente","href":"/glosario/#migrante-reciente","group":"Glosario","hint":"Persona que hace cinco años vivía en otro departamento o país (ENAHO, módulo 400)."},{"label":"Migración de toda la vida","href":"/glosario/#migraci-n-de-toda-la-vida","group":"Glosario","hint":"Persona cuya madre vivía en otro departamento cuando nació (pregunta disponible desde 2018)."},{"label":"Saldo migratorio neto","href":"/glosario/#saldo-migratorio-neto","group":"Glosario","hint":"Inmigrantes menos emigrantes de un departamento, por cada mil habitantes."},{"label":"Factor de expansión","href":"/glosario/#factor-de-expansi-n","group":"Glosario","hint":"Peso que convierte cada persona entrevistada en el número de personas que representa (fac500a, facpob07, factor07)."}]